# Copy this file to `.env` and fill in your values. `.env` is gitignored — never commit it.
# The translation layer (Claude API) is only needed for build step 4 onward;
# the detection layer (fetch/snapshot/diff) runs without a key.
ANTHROPIC_API_KEY=sk-ant-...

# --- Email delivery (optional) ---
# Gmail over SMTP. The username is your full Gmail address (and the From line).
# The app password is a 16-char password from https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled). Spaces in the app password are fine.
# The recipient address is NOT here — it's `email_to` in config.yaml.
SMTP_USERNAME=your_address@gmail.com
SMTP_APP_PASSWORD=abcd efgh ijkl mnop
